{
  "manifest_version": 3,
  "name": "Sound Adjuster",
  "version": "2.5.3",
  "description": "Boost and shape Firefox tab audio with up to 5× gain, stereo balance, a five-band EQ, local profiles, and shortcuts.",
  "permissions": [
    "webNavigation",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'"
  },
  "icons": {
    "16": "icon.svg",
    "48": "icon.svg",
    "96": "icon.svg",
    "128": "icon.svg"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ],
  "background": {
    "scripts": ["popup-state.js", "site-profiles.js", "site-exceptions.js", "named-profiles.js", "global-settings.js", "audio-storage.js", "background.js"]
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Sound Adjuster",
    "default_icon": {
      "16": "icon.svg",
      "48": "icon.svg",
      "128": "icon.svg"
    }
  },
  "commands": {
    "increase-gain": {
      "suggested_key": { "default": "Alt+Up" },
      "description": "Increase Sound Adjuster gain"
    },
    "decrease-gain": {
      "suggested_key": { "default": "Alt+Down" },
      "description": "Decrease Sound Adjuster gain"
    },
    "reset-audio": {
      "suggested_key": { "default": "Alt+Shift+0" },
      "description": "Reset Sound Adjuster settings"
    },
    "toggle-mono": {
      "suggested_key": { "default": "Alt+Shift+M" },
      "description": "Toggle mono audio"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{072d02fa-46fc-4392-9571-a2fa1a693cd9}",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
