{
  "manifest_version": 3,
  "name": "Sound Adjuster",
  "version": "2.6.0",
  "description": "Boost and shape tab audio with up to 5× gain, stereo balance, a five-band EQ, local profiles, and shortcuts.",
  "permissions": [
    "webNavigation",
    "scripting",
    "storage",
    "activeTab",
    "tabCapture",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "extension-api.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Sound Adjuster",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "increase-gain": {
      "suggested_key": {
        "default": "Alt+Up"
      },
      "description": "Increase Sound Adjuster gain"
    },
    "decrease-gain": {
      "suggested_key": {
        "default": "Alt+Down"
      },
      "description": "Decrease Sound Adjuster gain"
    },
    "reset-audio": {
      "suggested_key": {
        "default": "Alt+Shift+0"
      },
      "description": "Reset Sound Adjuster settings"
    },
    "toggle-mono": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "Toggle mono audio"
    }
  },
  "minimum_chrome_version": "124",
  "incognito": "split"
}
